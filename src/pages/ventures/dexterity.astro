---
import Base from "../../layouts/Base.astro";
import { getDexterityStages, getDexterityProducts } from "../../lib/dexterity";
import { getVentures, getVentureUrl } from "../../lib/ventures";
import { getCompanyNews } from "../../lib/news";
import "../../styles/ventures.css";
import "../../styles/mapping.css";
import "../../styles/dexterity.css";

const stages = getDexterityStages();
const products = getDexterityProducts();
const companies = new Map(
  getVentures().map((company) => [company.id, company]),
);
const topicIds = new Set([
  ...stages.flatMap((stage) => stage.entries.map((entry) => entry.company.id)),
  ...products.map((product) => product.companyId),
]);

const companyStageMap = new Map<string, string[]>();
for (const stage of stages) {
  for (const entry of stage.entries) {
    const list = companyStageMap.get(entry.companyId) || [];
    list.push(stage.name);
    companyStageMap.set(entry.companyId, list);
  }
}
const crossRoleCompanies = [...companyStageMap.entries()]
  .filter(([, roleNames]) => roleNames.length > 1)
  .map(([cid, roleNames]) => ({
    company: companies.get(cid)!,
    roleNames,
  }))
  .filter((item) => item.company);

const newsByCompany = new Map(
  [...topicIds].map((id) => [id, getCompanyNews(id)]),
);
const newsCount = new Set(
  [...newsByCompany.values()].flatMap((items) => items.map((item) => item.id)),
).size;
const value = (text: string) => text?.trim() || "未披露";

function summarizeMetric(text: string): { head: string; detail: string } {
  const clean = value(text);
  const parts = clean.split(/[；。]/).filter(Boolean);
  if (parts.length <= 1) return { head: clean, detail: "" };
  return {
    head: parts[0],
    detail: clean.slice(parts[0].length + 1).trim(),
  };
}

const researchChecks = [
  {
    title: "自由度与传动耦合",
    text: "分别核对主动自由度、运动自由度与执行器数量；记录耦合关系、传动路线（直驱 / 腱绳 / 电缸连杆）及驱动是否外置。",
  },
  {
    title: "力、重量范围与寿命",
    text: "区分指尖力、握力和整手负载，注明姿态、持续或峰值条件；核实重量是否计入前臂驱动、法兰与线缆。",
  },
  {
    title: "触觉覆盖与数据质量",
    text: "核对感知覆盖部位、法向/切向测量维度、采样频率与原始数据接口；采集数量需说明任务场景、有效片段和质量口径。",
  },
  {
    title: "任务复现与商业交付",
    text: "严格区分公开演示视频、可重复基准测试、客户试点与实际商业交付；比较成功率前先对齐任务协议与物体集合。",
  },
];
---

<Base
  title="灵巧操作与灵巧手技术栈专题"
  description="从驱动传动、手本体、触觉与力觉到数据采集、控制模型与集成应用，按公开证据梳理灵巧操作公司角色与具体型号参数对照。"
  current="dexterity"
>
  <div class="wrap page">
    <nav class="crumbs" aria-label="位置">
      <a href="/">首页</a>
      <span class="sep">/</span>
      <a href="/ventures/">产业图谱</a>
      <span class="sep">/</span>
      <a href="/ventures/robot-parts/">机器人核心部件</a>
      <span class="sep">/</span>
      <span aria-current="page">灵巧操作专题</span>
    </nav>

    <section class="panel profile" data-cat="venture">
      <div class="profile-top">
        <div class="profile-title">
          <div class="page-kicker">RESEARCH NOTE / 01</div>
          <h1>灵巧操作与灵巧手技术栈</h1>
        </div>
        <div class="actions">
          <a class="btn primary-action" href="/?segment=robot-parts%2Fhands">
            跟进灵巧手动态 →
          </a>
          <a class="btn" href="/ventures/robot-parts/">
            机器人核心部件赛道 →
          </a>
        </div>
      </div>
      <p class="intro">
        围绕「微型驱动 → 手本体与夹爪 → 触觉感知 → 遥操作与数采 → 控制模型 →
        机械臂集成」六类角色，梳理 {topicIds.size} 家代表公司的公开定位，并对{" "}
        {products.length} 款灵巧手型号进行参数与口径核对。
      </p>
      <div class="profile-stats">
        <div>
          <b class="num">{stages.length}</b>技术栈角色
        </div>
        <div>
          <b class="num">{topicIds.size}</b>已收录公司
        </div>
        <div>
          <b class="num">{products.length}</b>型号参数对照
        </div>
        <div>
          <b class="num">{crossRoleCompanies.length}</b>跨角色布局
        </div>
        <div>
          <b class="num">{newsCount}</b>历史归档报道
        </div>
      </div>
    </section>

    <!-- 模块一：代表型号参数并排对比 -->
    <section class="panel" id="products" style="margin-top:var(--sp-4)">
      <div class="panel-head">
        <h2>灵巧手代表型号参数对比</h2>
        <span class="hint">
          官方公开技术文档口径 · 已选{" "}
          <span class="mono" id="dex-selected-count">
            {products.length}
          </span>{" "}
          款并排对比
        </span>
        <span class="right">
          <button type="button" class="map-reset" id="dex-select-all">
            全选 ({products.length})
          </button>
          {" · "}
          <button type="button" class="map-reset" id="dex-select-default">
            代表路线 (3)
          </button>
        </span>
      </div>

      <div class="toolbar">
        <div class="map-filter-top">
          <div class="chips" role="group" aria-label="切换对比型号">
            {products.map((product) => {
              const key = `${product.companyId}::${product.product}`;
              const shortModel = product.product
                .replace(/（.*?）|\(.*?\)/g, "")
                .trim();
              return (
                <button
                  type="button"
                  class="chip is-on"
                  data-compare-pill={key}
                  aria-pressed="true"
                >
                  <span>
                    {product.companyName} · {shortModel}
                  </span>
                </button>
              );
            })}
          </div>

          <form class="dex-inline-search" id="dex-product-filter" role="search">
            <label class="filter-input">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>
              <input
                id="dex-product-query"
                type="search"
                placeholder="按型号或技术词筛选（如 Wuji Hand 2.2、直驱）…"
                autocomplete="off"
              />
            </label>
          </form>
        </div>
      </div>

      <div class="dex-compare-scroll" id="dex-compare-matrix-wrap">
        <table class="dex-compare-matrix" id="dex-compare-matrix">
          <thead>
            <tr>
              <th scope="col" class="dex-dim-col">
                参数维度
              </th>
              {products.map((product) => {
                const key = `${product.companyId}::${product.product}`;
                const company = companies.get(product.companyId);
                const searchBlob = [
                  product.companyName,
                  product.product,
                  product.form,
                  product.actuation,
                  product.dof,
                  product.weight,
                  product.sensing,
                  product.software,
                ].join(" ");
                return (
                  <th
                    scope="col"
                    data-compare-col={key}
                    data-product-search={searchBlob}
                  >
                    <div class="dex-col-head">
                      <div class="dex-col-top">
                        {company ? (
                          <a class="link" href={getVentureUrl(company)}>
                            {product.companyName}
                          </a>
                        ) : (
                          <span>{product.companyName}</span>
                        )}
                        <span class="badge badge-plain">
                          {company?.region === "cn" ? "国内" : "海外"}
                        </span>
                      </div>
                      <strong>{product.product}</strong>
                    </div>
                  </th>
                );
              })}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">形态与构型</th>
              {products.map((p) => {
                const key = `${p.companyId}::${p.product}`;
                const m = summarizeMetric(p.form);
                return (
                  <td data-compare-col={key}>
                    <strong class="dex-metric-lead">{m.head}</strong>
                    {m.detail && <p class="dex-metric-caveat">{m.detail}</p>}
                  </td>
                );
              })}
            </tr>
            <tr>
              <th scope="row">
                主动自由度与关节
                <small>区分独立控制与耦合</small>
              </th>
              {products.map((p) => {
                const key = `${p.companyId}::${p.product}`;
                const m = summarizeMetric(p.dof);
                return (
                  <td data-compare-col={key}>
                    <strong class="dex-metric-lead">{m.head}</strong>
                    {m.detail && <p class="dex-metric-caveat">{m.detail}</p>}
                  </td>
                );
              })}
            </tr>
            <tr>
              <th scope="row">
                驱动与传动路线
                <small>直驱 / 腱绳 / 电缸连杆</small>
              </th>
              {products.map((p) => {
                const key = `${p.companyId}::${p.product}`;
                const m = summarizeMetric(p.actuation);
                return (
                  <td data-compare-col={key}>
                    <strong class="dex-metric-lead">{m.head}</strong>
                    {m.detail && <p class="dex-metric-caveat">{m.detail}</p>}
                  </td>
                );
              })}
            </tr>
            <tr>
              <th scope="row">
                重量与计入范围
                <small>裸手 vs 含腕/线缆</small>
              </th>
              {products.map((p) => {
                const key = `${p.companyId}::${p.product}`;
                const m = summarizeMetric(p.weight);
                return (
                  <td data-compare-col={key}>
                    <strong class="dex-metric-lead">{m.head}</strong>
                    {m.detail && <p class="dex-metric-caveat">{m.detail}</p>}
                  </td>
                );
              })}
            </tr>
            <tr>
              <th scope="row">
                触觉 / 力觉感知
                <small>标配、选配或非触觉版</small>
              </th>
              {products.map((p) => {
                const key = `${p.companyId}::${p.product}`;
                const m = summarizeMetric(p.sensing);
                return (
                  <td data-compare-col={key}>
                    <strong class="dex-metric-lead">{m.head}</strong>
                    {m.detail && <p class="dex-metric-caveat">{m.detail}</p>}
                  </td>
                );
              })}
            </tr>
            <tr>
              <th scope="row">软件、采集与仿真</th>
              {products.map((p) => {
                const key = `${p.companyId}::${p.product}`;
                const m = summarizeMetric(p.software);
                return (
                  <td data-compare-col={key}>
                    <strong class="dex-metric-lead">{m.head}</strong>
                    {m.detail && <p class="dex-metric-caveat">{m.detail}</p>}
                  </td>
                );
              })}
            </tr>
            <tr>
              <th scope="row">公开依据与核验日</th>
              {products.map((p) => {
                const key = `${p.companyId}::${p.product}`;
                return (
                  <td data-compare-col={key}>
                    <div class="dex-product-sources">
                      {p.evidence.map((source) => (
                        <a
                          href={source.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {source.title} ↗
                        </a>
                      ))}
                      <small class="mono">核验 {p.verifiedAt}</small>
                    </div>
                  </td>
                );
              })}
            </tr>
          </tbody>
        </table>
      </div>

      <p class="search-empty" id="dex-product-empty" hidden>
        没有匹配该关键词的型号，请清空搜索词查看全部型号。
      </p>

      <div class="panel-foot">
        注：各型号参数均取自官方公开技术手册或产品页，不等于独立第三方实测；自由度与重量口径因厂商计入范围不同，不宜直接做简单数值排名。
      </div>
    </section>

    <!-- 模块二：六类研究角色名录 -->
    <section class="panel" id="roles" style="margin-top:var(--sp-4)">
      <div class="panel-head">
        <h2>六类技术栈角色与公司名录</h2>
        <span class="hint">
          共 {topicIds.size} 家公司（{crossRoleCompanies.length} 家跨多个角色）
        </span>
      </div>

      <div class="toolbar">
        <div class="map-filter-top">
          <div class="chips" role="tablist" aria-label="按研究角色筛选">
            <button type="button" class="chip is-on" data-role-filter="">
              全部角色
            </button>
            {stages.map((stage) => (
              <button type="button" class="chip" data-role-filter={stage.id}>
                {stage.name} <span class="n">{stage.entries.length}</span>
              </button>
            ))}
          </div>

          <div class="map-region-group" role="group" aria-label="按地区过滤">
            <button
              type="button"
              class="map-region-btn is-active"
              data-role-region=""
            >
              全部地区
            </button>
            <button type="button" class="map-region-btn" data-role-region="cn">
              国内
            </button>
            <button
              type="button"
              class="map-region-btn"
              data-role-region="global"
            >
              海外
            </button>
          </div>
        </div>
      </div>

      <div class="dex-role-groups">
        {stages.map((stage, index) => (
          <section
            class="org-group"
            data-role-section={stage.id}
            aria-labelledby={`role-${stage.id}`}
          >
            <div class="group-label">
              <span class="mono">{String(index + 1).padStart(2, "0")}</span>
              <strong id={`role-${stage.id}`}>{stage.name}</strong>
              <span class="muted">· {stage.description}</span>
              <span class="n" id={`role-count-${stage.id}`}>
                {stage.entries.length} 家
              </span>
            </div>

            <div class="org-list" id={`role-entries-${stage.id}`}>
              {stage.entries.map((entry) => {
                const roleList = companyStageMap.get(entry.companyId) || [];
                return (
                  <div
                    class="org-row dex-role-row"
                    data-entry-region={entry.company.region}
                  >
                    <div class="org-row-main">
                      <a
                        class="org-row-name link"
                        href={getVentureUrl(entry.company)}
                      >
                        {entry.company.name}
                      </a>
                      {entry.company.region === "global" && (
                        <span class="badge badge-plain">
                          {entry.company.country || "海外"}
                        </span>
                      )}
                      {roleList.length > 1 && (
                        <span
                          class="badge badge-plain"
                          title={`同时布局：${roleList.join("、")}`}
                        >
                          跨 {roleList.length} 角色
                        </span>
                      )}
                      <span class="org-row-full">
                        <strong>{value(entry.product)}</strong> · {entry.role}
                      </span>
                    </div>
                    <div class="org-row-meta">
                      <a
                        class="link"
                        href={entry.evidence.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {entry.evidence.title} ↗
                      </a>
                      <span class="stake">{entry.verifiedAt}</span>
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </section>

    <!-- 模块三：尽调核验清单 -->
    <section class="panel" id="research" style="margin-top:var(--sp-4)">
      <div class="panel-head">
        <h2>一级市场尽调与参数核验要点</h2>
        <span class="right">
          <a href="/ventures/coverage/">数据口径与新闻覆盖说明 →</a>
        </span>
      </div>
      <div class="panel-body dex-check-grid">
        {researchChecks.map((check, index) => (
          <div class="dex-check-item">
            <strong>
              <span class="mono">{String(index + 1).padStart(2, "0")}.</span>{" "}
              {check.title}
            </strong>
            <p>{check.text}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>

<script>
  const roleTabs = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-role-filter]"),
  ];
  const roleRegions = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-role-region]"),
  ];
  const roleSections = [
    ...document.querySelectorAll<HTMLElement>("[data-role-section]"),
  ];
  let activeRole = "";
  let activeRoleRegion = "";

  function applyRoleFilters() {
    roleTabs.forEach((t) =>
      t.classList.toggle("is-on", (t.dataset.roleFilter || "") === activeRole),
    );
    roleRegions.forEach((b) =>
      b.classList.toggle(
        "is-active",
        (b.dataset.roleRegion || "") === activeRoleRegion,
      ),
    );

    roleSections.forEach((sec) => {
      const sid = sec.dataset.roleSection || "";
      const roleMatch = !activeRole || activeRole === sid;
      if (!roleMatch) {
        sec.hidden = true;
        return;
      }
      const items = [
        ...sec.querySelectorAll<HTMLElement>("[data-entry-region]"),
      ];
      let visible = 0;
      items.forEach((li) => {
        const show =
          !activeRoleRegion || li.dataset.entryRegion === activeRoleRegion;
        li.hidden = !show;
        if (show) visible++;
      });
      sec.hidden = visible === 0;
    });
  }

  roleTabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      activeRole = tab.dataset.roleFilter || "";
      applyRoleFilters();
    }),
  );

  roleRegions.forEach((btn) =>
    btn.addEventListener("click", () => {
      activeRoleRegion = btn.dataset.roleRegion || "";
      applyRoleFilters();
    }),
  );

  // Side-by-Side Model Comparison Picker & Search
  const comparePills = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-compare-pill]"),
  ];
  const compareHeaders = [
    ...document.querySelectorAll<HTMLElement>("th[data-compare-col]"),
  ];
  const compareCols = [
    ...document.querySelectorAll<HTMLElement>("[data-compare-col]"),
  ];
  const selectedCountEl = document.getElementById("dex-selected-count");
  const matrixWrap = document.getElementById("dex-compare-matrix-wrap");
  const emptyEl = document.getElementById("dex-product-empty");
  const queryInput = document.getElementById(
    "dex-product-query",
  ) as HTMLInputElement | null;

  const allKeys = [
    ...new Set(comparePills.map((p) => p.dataset.comparePill || "")),
  ].filter(Boolean);
  const defaultKeys = allKeys.filter(
    (_, idx) => idx === 0 || idx === 2 || idx === 4,
  );
  const selectedSet = new Set(allKeys);

  const normalize = (value: string) =>
    value.normalize("NFKC").toLocaleLowerCase();

  function syncCompareMatrix() {
    const words = normalize(queryInput?.value.trim() || "")
      .split(/\s+/)
      .filter(Boolean);

    const matchingKeys = new Set<string>();
    compareHeaders.forEach((th) => {
      const key = th.dataset.compareCol || "";
      const hay = normalize(th.dataset.productSearch || "");
      const matchesSearch =
        words.length === 0 || words.every((w) => hay.includes(w));
      if (matchesSearch && selectedSet.has(key)) {
        matchingKeys.add(key);
      }
    });

    comparePills.forEach((pill) => {
      const key = pill.dataset.comparePill || "";
      const on = selectedSet.has(key);
      pill.classList.toggle("is-on", on);
      pill.setAttribute("aria-pressed", String(on));
    });

    compareCols.forEach((cell) => {
      const key = cell.dataset.compareCol || "";
      cell.hidden = !matchingKeys.has(key);
    });

    if (selectedCountEl)
      selectedCountEl.textContent = String(matchingKeys.size);
    if (matrixWrap) matrixWrap.hidden = matchingKeys.size === 0;
    if (emptyEl) emptyEl.hidden = matchingKeys.size > 0;
  }

  comparePills.forEach((pill) => {
    pill.addEventListener("click", () => {
      const key = pill.dataset.comparePill || "";
      if (selectedSet.has(key)) {
        if (selectedSet.size > 1) selectedSet.delete(key);
      } else {
        selectedSet.add(key);
      }
      syncCompareMatrix();
    });
  });

  document.getElementById("dex-select-all")?.addEventListener("click", () => {
    allKeys.forEach((k) => selectedSet.add(k));
    if (queryInput) queryInput.value = "";
    syncCompareMatrix();
  });

  document
    .getElementById("dex-select-default")
    ?.addEventListener("click", () => {
      selectedSet.clear();
      defaultKeys.forEach((k) => selectedSet.add(k));
      if (queryInput) queryInput.value = "";
      syncCompareMatrix();
    });

  queryInput?.addEventListener("input", syncCompareMatrix);
  document
    .getElementById("dex-product-filter")
    ?.addEventListener("submit", (e) => {
      e.preventDefault();
      syncCompareMatrix();
    });
</script>
