---
const { mark } = Astro.props;
---
<details class="suite-switch">
  <summary aria-label="切换产品，当前 FinMap">
    <img src={"data:image/svg+xml," + encodeURIComponent(mark)} width="25" height="25" alt="" />
    <strong>FinMap</strong>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </summary>
  <div class="suite-products">
    <a class="suite-product-link" href="https://finhot.fun/">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h5"/></svg>
      <span><strong>FinHot</strong><small>市场资讯与每日简报</small></span><span aria-hidden="true">↗</span>
    </a>
    <a class="suite-product-link" href="/" aria-current="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M12 8v5M5 16v-3h14v3"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="16" y="16" width="6" height="6" rx="1"/></svg>
      <span><strong>FinMap</strong><small>公司动态与产业研究</small></span><span aria-hidden="true">✓</span>
    </a>
  </div>
</details>
